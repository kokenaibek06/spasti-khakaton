# Скопируйте в .env и заполните ключ у себя. Сам .env в git не попадает.
# Провайдер: openai, ollama, hf. offline явно включает проверку без LLM.
MODEL_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Пустое значение использует стандартный OpenAI API.
OPENAI_BASE_URL=
# Для gpt-5.4-mini стандартного OpenAI API: 0.75 и 4.50 USD за 1 млн токенов.
# Для других моделей, HF и собственного endpoint тарифы обязательны.
# Пустые значения используют встроенный тариф только известной модели.
MODEL_INPUT_USD_PER_MILLION=
MODEL_OUTPUT_USD_PER_MILLION=
# Необязательно: none, low и другие значения, поддерживаемые вашей моделью.
MODEL_REASONING_EFFORT=

OLLAMA_MODEL=qwen3.5:4b
OLLAMA_BASE_URL=http://localhost:11434/v1
HF_TOKEN=
HF_MODEL=openai/gpt-oss-120b
HF_BASE_URL=https://router.huggingface.co/v1
